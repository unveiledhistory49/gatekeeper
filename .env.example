# Every GATEKEEPER_ var from internal/config/config.go.
# Copy to .env (gitignored) for local dev.

# Database URL. sqlite://<path> uses embedded sqlite; postgres://... uses pgx. (default: sqlite://./gatekeeper.db)
GATEKEEPER_DATABASE_URL=sqlite://./data/gatekeeper.db
# Listen address. (default: :8080)
GATEKEEPER_ADDR=:8080
# Pepper for API-key hashing. MUST be changed in production. (default: dev-pepper-change-me)
GATEKEEPER_PEPPER=dev-pepper-change-me
# Session lifetime in hours; non-positive falls back to 12. (default: 12)
GATEKEEPER_SESSION_HOURS=12
# OIDC SSO. All four must be set for OIDC routes to activate; otherwise /v1/oidc/* return 501.
GATEKEEPER_OIDC_ISSUER=
GATEKEEPER_OIDC_CLIENT_ID=
GATEKEEPER_OIDC_CLIENT_SECRET=
GATEKEEPER_OIDC_REDIRECT_URL=
